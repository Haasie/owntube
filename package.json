{
  "name": "owntube-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OwnTube monorepo — privacy-first YouTube frontend (apps/web) and TV client (apps/tv).",
  "license": "MIT",
  "homepage": "https://github.com/Haasie/owntube#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haasie/owntube.git"
  },
  "bugs": {
    "url": "https://github.com/Haasie/owntube/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter web test",
    "test:watch": "pnpm --filter web test:watch",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:generate": "pnpm --filter web db:generate",
    "db:studio": "pnpm --filter web db:studio",
    "warm:cache": "pnpm --filter web warm:cache",
    "check:upstream": "pnpm --filter web check:upstream",
    "export:icons": "pnpm --filter web export:icons"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.18",
      "next>sharp": "0.35.5",
      "nanoid@3": "3.3.18",
      "browserslist@4": "4.28.7",
      "source-map-js@1": "1.2.2",
      "brace-expansion@5": "5.0.11",
      "semver@7": "7.8.5",
      "baseline-browser-mapping": "2.11.33",
      "caniuse-lite": "1.0.30001819",
      "electron-to-chromium": "1.5.465",
      "node-releases": "2.0.60"
    }
  }
}
